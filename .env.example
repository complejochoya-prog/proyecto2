# Frontend
# En desarrollo, Vite usa http://localhost:3001/api por defecto.
# En producción, la API usa /api si VITE_API_URL no está definida.
VITE_API_URL=

# Backend
PORT=3001
NODE_ENV=production

# Orígenes web autorizados, separados por coma.
# Reemplazar por el/los dominios reales del frontend antes de desplegar.
API_ALLOWED_ORIGINS=https://tu-dominio.example

# Credenciales del propietario: configurar en el entorno privado del servidor, nunca en VITE_* ni en Git.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_PIN=
